{
  "compilerOptions": {
    "target": "ESNext",
    "baseUrl": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "#gel/queries": ["./src/runtime/server/composables/useGelQueries.ts"],
      "#gel/interfaces": ["./src/runtime/server/composables/useGelQueries.ts"],
      "#gel/builder": ["./src/runtime/server/composables/useGelQueryBuilder.ts"]
    },
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "sourceMap": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  }
}
